<style>
  body {
    <%= @feedback_submission.form_config['text_color'].present? ? "color: #{@feedback_submission.form_config['text_color']};".html_safe : '' %>
    <%= @feedback_submission.form_config['bg_color'].present? ? "background-color: #{@feedback_submission.form_config['bg_color']};".html_safe : '' %>
  }
</style>

<script src="https://js.hcaptcha.com/1/api.js" async defer></script>

<%= form_tag({controller: 'feedback_submissions', action: 'create', id: @feedback_submission.feedback_key}, method: 'post', id: 'feedback-form') do %>
  <% if @feedback_submission.form_config['form_title'].present? %>
  <h1><%= @feedback_submission.form_config['form_title'] %></h1>
  <% end %>

  <% inline_error_fields = [:feedback_type, :one_line_summary, :description, :name, :email] %>
  <% top_display_errors = @feedback_submission.errors.reject { |error| inline_error_fields.include?(error.attribute) } %>
  <% inline_form_display_errors = @feedback_submission.errors.select { |error| inline_error_fields.include?(error.attribute) } %>

  <% if params[:submitted_from_page].present? %>
    <div class="alert alert-info submitted-from-page-alert">Submitted from: <%= params[:submitted_from_page] %></div>
  <% end %>

  <% if top_display_errors.present? %>
    <div class="alert alert-danger small">
      <% top_display_errors.each do |error| %>
        <%= error.message %><br />
      <% end %>
    </div>
  <% end %>

  <% if inline_form_display_errors.present? %>
    <div class="alert alert-danger small">
      Please review your submission for errors.
    </div>
  <% end %>

  <%= hidden_field_tag 'submitted_from_page', params[:submitted_from_page] %>
  <%= hidden_field_tag 'window_width', params[:window_width] %>
  <%= hidden_field_tag 'window_height', params[:window_height] %>

  <div class="mb-3">
    <% if @feedback_submission.form_config['feedback_types'].present? %>
      <%= select_tag 'feedback_type', options_for_select(@feedback_submission.form_config['feedback_types'], params[:feedback_type]), class: "form-select form-select-sm #{'is-invalid' if @feedback_submission.errors.include?(:feedback_type)}", aria: { label: 'Feedback Type' } %>
    <% end %>
    <%= render_error_messages_if_present(@feedback_submission, :feedback_type) %>
  </div>
  <div class="mb-3">
    <%= text_field_tag(:one_line_summary, params[:one_line_summary], class: "form-control form-control-sm #{'is-invalid' if @feedback_submission.errors.include?(:one_line_summary)}", placeholder: 'One line summary', aria: { label: 'Summary' }) %>
    <%= render_error_messages_if_present(@feedback_submission, :one_line_summary) %>
  </div>
  <div class="mb-3">
    <%= text_area_tag(:description, params[:description], class: "form-control form-control-sm #{'is-invalid' if @feedback_submission.errors.include?(:description)}", placeholder: 'Description', rows: '3', aria: { label: 'Description'}) %>
    <%= render_error_messages_if_present(@feedback_submission, :description) %>
  </div>
  <div class="mb-3">
    <%= text_field_tag(:name, params[:name], class: "form-control form-control-sm #{'is-invalid' if @feedback_submission.errors.include?(:name)}", placeholder: 'Name (optional)', aria: { label: 'Name (optional)' }) %>
    <%= render_error_messages_if_present(@feedback_submission, :name) %>
  </div>
  <div class="mb-3">
    <%= text_field_tag(:email, params[:email], class: "form-control form-control-sm #{'is-invalid' if @feedback_submission.errors.include?(:email)}", placeholder: 'Email (optional)', aria: { label: 'Email (optional)'}) %>
    <%= render_error_messages_if_present(@feedback_submission, :email) %>
  </div>

  <div class="h-captcha" data-sitekey="<%= Hcaptcha::SITE_KEY %>"></div>

  <div class="actions">
    <%= submit_tag('Submit', :class => 'btn btn-secondary btn-sm float-end') %>
    <div class="clearfix"></div>
  </div>
<% end %>
